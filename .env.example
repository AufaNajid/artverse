# Copy this template only if .env does not exist. Keep all secrets out of Git/chat.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
CMS_OWNER_ID=
SUPABASE_STORAGE_BUCKET=portfolio

# Runtime: use a restricted portfolio_app transaction-pooler connection.
# For port 6543 include pgbouncer=true&connection_limit=3 in the query string.
DATABASE_URL=

# Trusted local/CI migrations and initial seed use this direct/session connection.
# In the production website, BOTH URL variables must use the restricted role.
DIRECT_URL=
